{
  "name": "@acaos/backend-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./lib/*.js": {
      "acaos-src": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./services/*.js": {
      "acaos-src": "./src/services/*.ts",
      "types": "./dist/services/*.d.ts",
      "default": "./dist/services/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/ensure-prisma-client.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.4",
    "imapflow": "^1.7.8",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.1.1",
    "openai": "^7.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
