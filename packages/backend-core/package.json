{
  "name": "@acaos/backend-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./lib/*.js": {
      "acaos-src": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./services/*.js": {
      "acaos-src": "./src/services/*.ts",
      "types": "./dist/services/*.d.ts",
      "default": "./dist/services/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/ensure-prisma-client.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@acaos/shared": "*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.6",
    "imapflow": "^2.0.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "openai": "^7.15.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
