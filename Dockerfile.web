# Pinned to the immutable multi-arch index digest for reproducible builds; the
# tag is kept as a comment for readability. Dependabot (docker ecosystem) bumps
# the digest+tag. Re-resolve with:
#   docker buildx imagetools inspect node:26-alpine --format '{{json .Manifest.Digest}}'
FROM node:26-alpine@sha256:e88a35be04478413b7c71c455cd9865de9b9360e1f43456be5951032d7ac1a66 AS builder
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/
# scripts/ must exist before `npm ci` so the root postinstall script is present
# (it no-ops here — the Prisma schema isn't part of the web build context).
COPY scripts ./scripts

# --include=dev so vite/typescript (devDependencies) are present for the build
# even when NODE_ENV=production is injected into the build env (Railway).
RUN npm ci --include=dev --ignore-optional

COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm --workspace @acaos/web run build

# Unprivileged nginx: runs as UID 101 (non-root), writes its pid + temp paths
# under /tmp, and listens on 8080 by default — no root, no Linux capabilities
# needed to bind a privileged port. Pinned to the immutable multi-arch index
# digest (covers amd64 + arm64); tag kept as a comment. Dependabot (docker
# ecosystem) bumps the digest+tag. Re-resolve with:
#   docker buildx imagetools inspect nginxinc/nginx-unprivileged:alpine --format '{{json .Manifest.Digest}}'
FROM nginxinc/nginx-unprivileged:alpine@sha256:592b23aa79a6e6c08ba4b20f1fff700e1328895705966722608e115d62e52d39
# Patch base-image OS packages that carry published security fixes post-dating
# the pinned digest, flagged by the Trivy HIGH/CRITICAL gate. Named-package
# upgrades here (libexpat, then curl/libcurl/libssl3/libcrypto3/util-linux, then
# c-ares) chased three separate CVE batches published against this same pinned
# base within one session — a whole-system upgrade avoids re-editing this line
# for every new CVE that lands between scans, at the cost of pulling in
# whatever's newest in the Alpine repo at build time rather than just the
# packages with known fixes. apk needs root; drop back to the unprivileged
# nginx user (101) so the container still runs non-root at runtime.
USER root
RUN apk upgrade --no-cache
USER 101
# COPY runs as root (build daemon) regardless of the base image's USER 101, so
# the SPA assets and our hardened server block land readable by the nginx user.
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Non-privileged listen port (see `listen 8080` in nginx.conf). The container
# still runs as USER 101 inherited from the base image.
EXPOSE 8080

# Liveness from inside the container, for parity with Dockerfile.api/.worker.
# This image's final stage is nginx (no Node runtime), so — unlike the API's
# `node -e "fetch(...)"` probe against /api/ready — this uses wget (present in
# the alpine base via busybox) against nginx's own root, the only "is this
# process serving traffic" signal a static SPA has; there is no app-level
# readiness endpoint to check.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
